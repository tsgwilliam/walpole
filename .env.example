# Keeper's desk. Required in production.
# In development, if this is unset, the password is walpole-dip.
ADMIN_PASSWORD=

# Signs the desk cookie. Defaults to ADMIN_PASSWORD when unset.
# Set a long random string before you expose the app.
ADMIN_SESSION_SECRET=

# Provisional chop pilot, in knots. These two anchors split the wind into
# five phrases. A southerly or south-westerly steps the phrase down one.
# CHOP_LIGHT_KT=10
# CHOP_STRONG_KT=18

# No tide, weather, or sewage API key is required.
# EasyTide (UKHO leisure JSON), Open-Meteo, and Southern Water's
# public Rivers and Seas Watch layer are used as documented in the README.
# The Admiralty Tidal API and Surfers Against Sewage are not called.
